# Server-only Hugging Face access token. Never prefix this with NEXT_PUBLIC_.
HF_TOKEN=hf_example_replace_with_your_private_token

# Public reCAPTCHA site key; this value is visible in the browser by design.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Private reCAPTCHA secret; server-only.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
